# ServiceHub Backend Environment Variables
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Connection String (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/servicehub_db?schema=public"

# Authentication Secrets & Expirations
JWT_ACCESS_SECRET="change-this-to-a-secure-random-secret-for-access-tokens"
JWT_REFRESH_SECRET="change-this-to-a-secure-random-secret-for-refresh-tokens"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
